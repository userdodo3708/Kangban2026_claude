# 复制为 .env 后按本机环境填写；.env 不提交到版本库。
APP_NAME=konban
APP_VERSION=0.1.0
APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO

# 仅连接本机 Docker 或教学 mock，禁止指向生产数据库。
DATABASE_URL=postgresql+psycopg2://localhost:5432/konban
REDIS_URL=redis://localhost:6379/0

# 第三方模型/语音密钥只放在 .env，不写进代码。
# DEEPSEEK_API_KEY=
# ASR_API_KEY=
# TTS_API_KEY=
